<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>V6ThemeLauncher</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WinExe: no console window. This is the whole point of the launcher. -->
    <UseWindowsForms>false</UseWindowsForms>

    <!-- Application icon. Uses the same artwork as V6PAC so the two tools read
         as one family: the .ico carries 16/24/32/48/64/128/256, which is what
         Explorer, the taskbar and Alt+Tab each ask for. -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Version info shown in the file's Properties > Details tab. Without
         these the exe reports an empty "File version" and looks unsigned-off. -->
    <Product>V6 Theme</Product>
    <AssemblyTitle>V6主题版</AssemblyTitle>
    <Description>以内存注入方式为 VOCALOID6 Editor 换肤，不写入安装目录</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>kongbaihla</Company>
  </PropertyGroup>

  <!--
    Single-file publish.
    The launcher is deliberately ONE self-contained .exe: it is copied next to
    V6ThemeHook.dll with nothing else, so it must not need its own
    .runtimeconfig.json / .deps.json side-cars (missing them was observed as
    "exe does nothing at all": no log, no window, no process).
    SelfContained stays on so the launcher does not depend on a machine-wide
    .NET runtime; the editor it starts still uses the runtime that ships with
    VOCALOID6.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

</Project>
